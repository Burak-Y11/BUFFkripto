PORT=3001

# PostgreSQL bağlantı adresi
# Railway'de otomatik enjekte edilir.
# Yerel geliştirme için: postgresql://postgres:SIFRE@localhost:5432/buffdb
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Groq API anahtarı — https://console.groq.com
GROQ_API_KEY=gsk_BURAYA_KENDI_GROQ_API_ANAHTARINIZI_YAZIN

# JWT imzalama şifresi — en az 32 karakter, rastgele güçlü bir değer
JWT_SECRET=BURAYA_EN_AZ_32_KARAKTERLIK_GUCLU_BIR_SIFRE_YAZIN

# Frontend'in canlı URL'i (Railway/Vercel/Netlify'dan alınır)
# Birden fazla origin için virgülle ayırın: https://buff.vercel.app,https://buff.netlify.app
# Test için tüm origin'lere izin: *
ALLOWED_ORIGIN=https://SENIN_FRONTEND_URLIN.vercel.app

# Ortam (Railway'de "production" olarak ayarla)
NODE_ENV=production
