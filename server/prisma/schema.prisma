// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// PostgreSQL (Railway, Supabase, PlanetScale vs.)
// Railway'de DATABASE_URL otomatik olarak enjekte edilir.
// ─────────────────────────────────────────────────────────────────────────────
datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
